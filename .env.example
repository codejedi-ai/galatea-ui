# Base URL of the Go galatea_server (Connect RPC over JSON).
GALATEA_SERVER_URL=http://localhost:8080

# Vercel AI Gateway key used by the companion chat (temporary; Vault will replace this).
AI_GATEWAY_API_KEY=

# Optional: override the default companion model, e.g. anthropic/claude-sonnet-5.5
COMPANION_DEFAULT_MODEL=

# Set to 1 to enable the development test login in a non-Vercel production build (always off on Vercel; dev-only otherwise).
GALATEA_TEST_LOGIN=
# Development-only test login email (default test@galatea.local); disabled on Vercel.
GALATEA_TEST_EMAIL=
# Development-only test login password (default galatea-test); disabled on Vercel.
GALATEA_TEST_PASSWORD=
# Secret used to sign test-login session tokens (development-only; a fixed dev fallback is used when test login is enabled and this is unset).
GALATEA_SESSION_SECRET=
